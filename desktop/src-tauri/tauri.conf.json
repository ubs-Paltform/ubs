{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UBS",
  "version": "3.11.1",
  "identifier": "dev.ubs.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "UBS",
        "width": 1482,
        "height": 986,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0b1016"
      }
    ],
    "security": {
      "capabilities": ["main-capability"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self'",
        "script-src": "'self'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Fast, safe release builds",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../../build.sh": "ubs-runtime/build.sh",
      "../../scripts/": "ubs-runtime/scripts/",
      "../../templates/": "ubs-runtime/templates/",
      "../../VERSION": "ubs-runtime/VERSION"
    }
  }
}
